<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>Display</name>
  <width>1500</width>
  <height>1020</height>
  <background_color>
    <color name="Interface Background" red="220" green="225" blue="221">
    </color>
  </background_color>
  <widget type="rectangle" version="2.0.0">
    <name>Rectangle</name>
    <y>100</y>
    <width>740</width>
    <height>440</height>
    <line_width>0</line_width>
    <line_color>
      <color name="Group_Outline" red="150" green="155" blue="151">
      </color>
    </line_color>
    <background_color>
      <color name="Group_Background" red="200" green="205" blue="201">
      </color>
    </background_color>
  </widget>
  <widget type="textentry" version="3.0.0">
    <name>Text Entry</name>
    <pv_name>ml-nn:ex3:set_time</pv_name>
    <x>160</x>
    <y>140</y>
    <width>140</width>
    <height>50</height>
  </widget>
  <widget type="xyplot" version="3.0.0">
    <name>X/Y Plot</name>
    <x>20</x>
    <y>220</y>
    <x_axis>
      <title>X</title>
      <autoscale>true</autoscale>
      <log_scale>false</log_scale>
      <minimum>0.0</minimum>
      <maximum>100.0</maximum>
      <show_grid>false</show_grid>
      <title_font>
        <font name="Default Bold" family="Source Sans Pro" style="BOLD" size="16.0">
        </font>
      </title_font>
      <scale_font>
        <font name="Default" family="Source Sans Pro" style="REGULAR" size="16.0">
        </font>
      </scale_font>
      <visible>true</visible>
    </x_axis>
    <y_axes>
      <y_axis>
        <title>Y</title>
        <autoscale>true</autoscale>
        <log_scale>false</log_scale>
        <minimum>0.0</minimum>
        <maximum>100.0</maximum>
        <show_grid>false</show_grid>
        <title_font>
          <font name="Default Bold" family="Source Sans Pro" style="BOLD" size="16.0">
          </font>
        </title_font>
        <scale_font>
          <font name="Default" family="Source Sans Pro" style="REGULAR" size="16.0">
          </font>
        </scale_font>
        <on_right>false</on_right>
        <visible>true</visible>
        <color>
          <color name="Text" red="25" green="25" blue="25">
          </color>
        </color>
      </y_axis>
    </y_axes>
    <traces>
      <trace>
        <name>$(traces[0].y_pv)</name>
        <x_pv>ml-nn:ex3:time</x_pv>
        <y_pv>ml-nn:ex3:temperature</y_pv>
        <err_pv></err_pv>
        <axis>0</axis>
        <trace_type>1</trace_type>
        <color>
          <color red="0" green="0" blue="255">
          </color>
        </color>
        <line_width>1</line_width>
        <line_style>0</line_style>
        <point_type>0</point_type>
        <point_size>10</point_size>
        <visible>true</visible>
      </trace>
      <trace>
        <name>$(traces[1].y_pv)</name>
        <x_pv>ml-nn:ex3:time</x_pv>
        <y_pv>ml-nn:ex3:temperature_ref</y_pv>
        <err_pv></err_pv>
        <axis>0</axis>
        <trace_type>1</trace_type>
        <color>
          <color red="255" green="0" blue="0">
          </color>
        </color>
        <line_width>1</line_width>
        <line_style>0</line_style>
        <point_type>0</point_type>
        <point_size>10</point_size>
        <visible>true</visible>
      </trace>
    </traces>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Text Update_1</name>
    <pv_name>ml-nn:ex3:hour_24</pv_name>
    <x>610</x>
    <y>280</y>
    <precision>1</precision>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Text Update_2</name>
    <pv_name>ml-nn:ex3:hour_24_q_10</pv_name>
    <x>610</x>
    <y>310</y>
    <precision>1</precision>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Text Update_3</name>
    <pv_name>ml-nn:ex3:hour_24_q_90</pv_name>
    <x>610</x>
    <y>250</y>
    <precision>1</precision>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Text Update_4</name>
    <pv_name>ml-nn:ex3:hour_48</pv_name>
    <x>610</x>
    <y>400</y>
    <precision>1</precision>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Text Update_5</name>
    <pv_name>ml-nn:ex3:hour_48_q_10</pv_name>
    <x>610</x>
    <y>430</y>
    <precision>1</precision>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Text Update_6</name>
    <pv_name>ml-nn:ex3:hour_48_q_90</pv_name>
    <x>610</x>
    <y>370</y>
    <precision>1</precision>
  </widget>
  <widget type="led" version="2.0.0">
    <name>LED</name>
    <pv_name>ml-nn:ex3:bad</pv_name>
    <x>327</x>
    <y>145</y>
    <width>40</width>
    <height>40</height>
    <off_label>:)</off_label>
    <off_color>
      <color name="OK" red="65" green="229" blue="65">
      </color>
    </off_color>
    <on_label>:(</on_label>
    <on_color>
      <color name="MAJOR" red="255" green="31" blue="26">
      </color>
    </on_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_1</name>
    <text>24 h - High Forecast (°C)</text>
    <x>430</x>
    <y>250</y>
    <width>170</width>
    <height>30</height>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_2</name>
    <text>24 h - Mean Forecast (°C)</text>
    <x>430</x>
    <y>280</y>
    <width>170</width>
    <height>30</height>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_3</name>
    <text>24 h - Low Forecast (°C)</text>
    <x>430</x>
    <y>310</y>
    <width>170</width>
    <height>30</height>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_4</name>
    <text>48 h - High Forecast (°C)</text>
    <x>430</x>
    <y>370</y>
    <width>170</width>
    <height>30</height>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_5</name>
    <text>48 h - Mean Forecast (°C)</text>
    <x>430</x>
    <y>400</y>
    <width>170</width>
    <height>30</height>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_6</name>
    <text>48 h - Low Forecast (°C)</text>
    <x>430</x>
    <y>430</y>
    <width>170</width>
    <height>30</height>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <text>Forecast from:</text>
    <x>40</x>
    <y>152</y>
    <height>25</height>
  </widget>
  <widget type="rectangle" version="2.0.0">
    <name>Rectangle_1</name>
    <width>740</width>
    <height>50</height>
    <line_width>0</line_width>
    <background_color>
      <color name="Standard_Title_Bar" red="151" green="188" blue="202">
      </color>
    </background_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_7</name>
    <class>TITLE</class>
    <text>Previsione di temperatura</text>
    <x use_class="true">20</x>
    <y use_class="true">0</y>
    <width>407</width>
    <height use_class="true">52</height>
    <font use_class="true">
      <font name="_ESS Title" family="Source Sans Pro" style="BOLD_ITALIC" size="36.0">
      </font>
    </font>
    <foreground_color use_class="true">
      <color name="Black" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <transparent use_class="true">true</transparent>
    <horizontal_alignment use_class="true">0</horizontal_alignment>
    <vertical_alignment use_class="true">1</vertical_alignment>
    <auto_size>true</auto_size>
    <wrap_words use_class="true">false</wrap_words>
  </widget>
</display>
